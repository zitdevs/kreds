# ---------------------------------------------------------------------------
# Kreds — environment
#
# Copy to .env and fill in:  cp .env.example .env
# Never commit .env — it is already in .gitignore.
#
# Full walkthrough: docs/self-hosting.md
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------

# Public origin of your instance, no trailing slash.
# Used for OAuth callbacks and share links, so it must be the URL people
# actually reach — not localhost once you are behind a proxy.
KREDS_URL=http://localhost:3000

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Postgres 15+. docker-compose.yml wires this for you when you use it.
DATABASE_URL=postgresql://kreds:kreds@localhost:5432/kreds


# --- GitHub OAuth App (identifies the person signing in) -------------------
#
# Create at: https://github.com/settings/developers -> New OAuth App
# Callback URL: <KREDS_URL>/api/auth/callback/github
# Scopes requested at runtime: read:user, read:org
# This grant never touches your code.

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=


# --- GitHub App (where all activity comes from) ----------------------------
#
# Create at: https://github.com/settings/apps -> New GitHub App
# Installed once, by an admin, on your organization.
#
#   Repository permissions:  Metadata (read), Pull requests (read),
#                            Issues (read)
#   Subscribe to events:     pull_request, pull_request_review, issues
#   Webhook URL:             <KREDS_URL>/api/github/webhook

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The downloaded .pem, as a single line. This is the step everyone gets wrong.
# Convert it with:  awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem
# Base64 works too:  base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# The webhook secret you set on the App. Generate with: openssl rand -hex 32
# Deliveries that fail signature verification are rejected, so this is not
# optional — without it anyone who finds your webhook URL can award Kreds.
GITHUB_WEBHOOK_SECRET=


# --- Optional --------------------------------------------------------------

# Redis for the webhook queue. Without it events are processed in-process,
# which is fine for a small team and not fine for a burst of merges.
REDIS_URL=

# Comma-separated GitHub logins that bypass team admin checks on this
# instance. Useful for the first boot; empty is the right answer afterwards.
KREDS_SUPERADMINS=

# Host port the container binds to. Defaults to 3000.
PORT=3000
