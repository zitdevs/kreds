{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Nest 12 ships ESM-only. The app stays CommonJS and loads it through
    // require(esm), which Node unflags from 20.19 and 22.12 (see engines).
    // `bundler` resolves through package `exports` without the per-file format
    // check that makes nodenext refuse a require of an ES module.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    // Inside outDir on purpose. `nest build` sets `deleteOutDir`, so when the
    // build state lived outside dist it survived the delete and told tsc
    // everything was current, and the build emitted nothing while exiting 0.
    // Sharing a lifetime with the output is what makes that impossible.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
