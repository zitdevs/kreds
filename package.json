{
  "name": "kreds",
  "version": "0.1.0",
  "private": true,
  "description": "The leaderboard for your engineering team.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @kreds/web dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @kreds/api dev",
    "dev:docs": "pnpm --filter @kreds/docs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "prepare": "husky",
    "start": "pnpm --filter @kreds/web start",
    "test": "pnpm -r test",
    "test:affected": "sh scripts/test-affected.sh",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
