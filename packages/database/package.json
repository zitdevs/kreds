{
  "name": "@kreds/database",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The Kreds persistence layer. Schema, migrations, and repositories that speak in domain types.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:related": "tsc --noEmit && vitest run --changed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@kreds/domain": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.4"
  }
}
