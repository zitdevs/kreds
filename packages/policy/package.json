{
  "name": "@kreds/policy",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The published economic policy, copied from kreds-laws and read at runtime. Generated, not authored.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:related": "tsc --noEmit && vitest run --changed"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.4"
  }
}
